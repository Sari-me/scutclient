#!/bin/sh
# scutclient-portal-probe - interface-bound captive portal Location probe.
#
# Usage: scutclient-portal-probe <logical-if> <real-netdev> [source-ipv4]
#
# Performs GET http://connectivitycheck.gstatic.com/generate_204 bound to
# the given netdev's source IPv4 (preferred, passed by the LuCI
# controller from the netifd dump) or the netdev itself, WITHOUT
# following redirects (the first-hop Location is exactly what we want),
# and prints:
#
#   http_code=<HTTP status>
#   location=<resolved redirect target, empty when none>
#
# It never touches UCI, never reloads networking and never logs in; the
# LuCI controller owns interpretation and persistence.
#
# Exit codes: 0 probe executed, 2 invalid device, 3 device not found,
# 4 curl failed.

PROBE_URL="http://connectivitycheck.gstatic.com/generate_204"

logical_if="$1"
device="$2"
source_ip="$3"

# logical_if 仅用于 mwan3 use 前缀：字符集校验，防注入
case "$logical_if" in
	""|*[!A-Za-z0-9_.-]*)
		logical_if=""
		;;
esac

case "$device" in
	""|*[!A-Za-z0-9_.:-]*)
		echo "error=invalid_device"
		exit 2
		;;
esac

[ -e "/sys/class/net/$device" ] || {
	echo "error=device_not_found"
	exit 3
}

# 无线 netdev 设备名绑定间歇性失败：优先按源 IPv4 绑定（由 LuCI
# controller 从 netifd dump 解析后传入）。mwan3 运行时经官方
# 'mwan3 use <logical-if>' 启动 curl，与 daemon 路径保持一致。
bind_target="$device"
case "$source_ip" in
	*.*) bind_target="$source_ip" ;;
esac

mwan3_prefix=""
if [ -x /usr/sbin/mwan3 ] &&
   [ -r /lib/mwan3/libwrap_mwan3_sockopt.so.1.0 ] &&
   [ -x /etc/init.d/mwan3 ] &&
   /etc/init.d/mwan3 running >/dev/null 2>&1 &&
   [ -n "$logical_if" ]; then
	mwan3_prefix="/usr/sbin/mwan3 use $logical_if"
fi

command -v curl >/dev/null 2>&1 || {
	echo "error=curl_missing"
	exit 5
}

result="$(
	$mwan3_prefix curl \
		--interface "$bind_target" \
		-sS \
		--connect-timeout 5 \
		--max-time 8 \
		--max-redirs 0 \
		-o /dev/null \
		-w '%{http_code}\n%{redirect_url}\n' \
		"$PROBE_URL" 2>/dev/null
)"

rc=$?

[ "$rc" -eq 0 ] || {
	echo "error=curl_failed"
	echo "curl_code=$rc"
	exit 4
}

http_code="$(printf '%s\n' "$result" | sed -n '1p')"
location="$(printf '%s\n' "$result" | sed -n '2p')"

echo "http_code=$http_code"
echo "location=$location"
exit 0
