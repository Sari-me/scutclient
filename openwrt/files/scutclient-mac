#!/bin/sh
# scutclient-mac - per-instance MAC helper for scutclient.
#
# Commands:
#   scutclient-mac gen                 Print a random locally administered,
#                                      unicast MAC address.
#   scutclient-mac prepare <instance>  Make sure the instance has a MAC and
#                                      that it is written into network /
#                                      wireless UCI. NEVER reloads networking.
#                                      Prints one of: none / network / wireless
#                                      (which config was touched).
#   scutclient-mac verify <instance>   Resolve the current real netdev and
#                                      compare its MAC with the configured
#                                      target. Prints the device name.
#
# The helper never runs `wifi reload` or `/etc/init.d/network reload`:
# multi-instance startup prepares ALL instance MACs first and applies the
# network with a single reload, so a per-instance reload cannot tear down
# other instances. Only UCI section names of /etc/config/scutclient are
# accepted as instance identifiers.

CONFIG="scutclient"
GEN_ATTEMPTS=16

die() {
	logger -t scutclient-mac "$1"
	echo "$1" >&2
	exit 1
}

usage() {
	echo "Usage: scutclient-mac gen" >&2
	echo "       scutclient-mac prepare <instance>" >&2
	echo "       scutclient-mac verify <instance>" >&2
	exit 1
}

cmd_gen() {
	local raw b1 b2 b3 b4 b5 b6

	raw="$(od -An -N6 -tu1 /dev/urandom | tr -s ' \n' '  ')"
	set -- $raw
	[ $# -ge 6 ] || die "gen: unable to read random bytes"

	b1="$1"; b2="$2"; b3="$3"; b4="$4"; b5="$5"; b6="$6"

	# Locally administered (bit1=1) and unicast (bit0=0).
	b1=$(( (b1 & 0xFC) | 0x02 ))

	printf '%02X:%02X:%02X:%02X:%02X:%02X\n' \
		"$b1" "$b2" "$b3" "$b4" "$b5" "$b6"
}

instance_type() {
	uci -q show "$CONFIG.$1" 2>/dev/null | head -n 1 | cut -d= -f2
}

lower() {
	printf '%s' "$1" | tr 'A-F' 'a-f'
}

# Resolve the logical interface of an instance to a real netdev.
resolve_device() {
	local configured="$1"
	local device=""

	[ -e "/sys/class/net/$configured" ] && {
		printf '%s\n' "$configured"
		return 0
	}

	device="$(ubus call network.interface."$configured" status 2>/dev/null | \
		jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ -n "$device" ] || device="$(ubus call network.interface."$configured" status 2>/dev/null | \
		jsonfilter -e '@.device' 2>/dev/null)"
	[ -n "$device" ] || return 1

	[ -e "/sys/class/net/$device" ] || return 1

	printf '%s\n' "$device"
}

# Find the wireless STA section in /etc/config/wireless whose network list
# contains $1. Prints the section name.
find_wifi_section() {
	local net="$1"
	local sec mode list item

	for sec in $(uci -q show wireless 2>/dev/null | \
			grep '\.network=' | cut -d. -f2 | cut -d= -f1); do
		[ "$(uci -q get "wireless.$sec.mode" 2>/dev/null)" = "sta" ] || continue
		list="$(uci -q get "wireless.$sec.network" 2>/dev/null)"
		for item in $list; do
			[ "$item" = "$net" ] && {
				printf '%s\n' "$sec"
				return 0
			}
		done
	done
	return 1
}

# Wired device: persist the MAC through a network device section.
apply_wired_mac() {
	local dev="$1" mac="$2"
	local sec devname

	for sec in $(uci -q show network 2>/dev/null | \
			grep '=device$' | cut -d. -f2 | cut -d= -f1); do
		devname="$(uci -q get "network.$sec.name" 2>/dev/null)"
		[ "$devname" = "$dev" ] || continue
		uci -q set "network.$sec.macaddr=$mac"
		uci -q commit network
		return 0
	done

	sec="$(uci add network device)" || return 1
	uci -q set "network.$sec.name=$dev"
	uci -q set "network.$sec.macaddr=$mac"
	uci -q commit network
}

# Wireless STA: persist the MAC on the matching wifi-iface.
apply_wireless_mac() {
	local net="$1" mac="$2"
	local sec

	sec="$(find_wifi_section "$net")" || return 1
	uci -q set "wireless.$sec.macaddr=$mac"
	uci -q commit wireless
}

# Random MAC unique across every other instance in /etc/config/scutclient.
gen_unique_mac() {
	local section="$1"
	local i=0 candidate conflict sec other

	while [ "$i" -lt "$GEN_ATTEMPTS" ]; do
		candidate="$(cmd_gen)"
		conflict=0

		for sec in $(uci -q show "$CONFIG" 2>/dev/null | \
				grep "=scutclient$" | cut -d. -f2 | cut -d= -f1); do
			[ "$sec" = "$section" ] && continue
			other="$(uci -q get "$CONFIG.$sec.macaddr" 2>/dev/null)"
			[ -n "$other" ] || continue
			[ "$(lower "$other")" = "$(lower "$candidate")" ] && conflict=1
		done

		[ "$conflict" -eq 0 ] && {
			printf '%s\n' "$candidate"
			return 0
		}

		i=$((i + 1))
	done

	return 1
}

valid_mac() {
	printf '%s' "$1" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'
}

cmd_prepare() {
	local section="$1"
	local mac_mode macaddr interface dev cur_mac

	[ -n "$section" ] || usage
	[ "$(instance_type "$section")" = "scutclient" ] || \
		die "prepare: no such scutclient instance '$section'"

	mac_mode="$(uci -q get "$CONFIG.$section.mac_mode" 2>/dev/null)"
	mac_mode="${mac_mode:-keep}"

	[ "$mac_mode" = "keep" ] && {
		echo none
		return 0
	}

	macaddr="$(uci -q get "$CONFIG.$section.macaddr" 2>/dev/null)"

	if [ "$mac_mode" = "random" ]; then
		if [ -z "$macaddr" ]; then
			macaddr="$(gen_unique_mac "$section")" || \
				die "prepare: unable to generate a unique random MAC for '$section'"
			uci -q set "$CONFIG.$section.macaddr=$macaddr"
			uci -q commit "$CONFIG"
			logger -t scutclient-mac \
				"instance '$section': generated random MAC $macaddr"
		fi
	else
		[ "$mac_mode" = "custom" ] || \
			die "prepare: unknown mac_mode '$mac_mode'"
		[ -n "$macaddr" ] || \
			die "prepare: instance '$section' uses custom MAC but macaddr is empty"
	fi

	valid_mac "$macaddr" || \
		die "prepare: instance '$section' has invalid macaddr '$macaddr'"

	interface="$(uci -q get "$CONFIG.$section.interface" 2>/dev/null)"
	[ -n "$interface" ] || \
		die "prepare: instance '$section' has no interface configured"

	dev="$(resolve_device "$interface")" || \
		die "prepare: unable to resolve device of instance '$section' ($interface)"

	cur_mac="$(cat "/sys/class/net/$dev/address" 2>/dev/null)"
	if [ "$(lower "$cur_mac")" = "$(lower "$macaddr")" ]; then
		echo none
		return 0
	fi

	if [ -e "/sys/class/net/$dev/phy80211" ] || \
	   find_wifi_section "$interface" >/dev/null 2>&1; then
		apply_wireless_mac "$interface" "$macaddr" || \
			die "prepare: no wireless STA section for '$interface' (instance '$section')"
		echo wireless
	else
		apply_wired_mac "$dev" "$macaddr" || \
			die "prepare: unable to persist MAC for '$dev'"
		echo network
	fi
}

cmd_verify() {
	local section="$1"
	local mac_mode macaddr interface dev cur_mac

	[ -n "$section" ] || usage
	[ "$(instance_type "$section")" = "scutclient" ] || \
		die "verify: no such scutclient instance '$section'"

	mac_mode="$(uci -q get "$CONFIG.$section.mac_mode" 2>/dev/null)"
	mac_mode="${mac_mode:-keep}"

	interface="$(uci -q get "$CONFIG.$section.interface" 2>/dev/null)"
	[ -n "$interface" ] || \
		die "verify: instance '$section' has no interface configured"

	dev="$(resolve_device "$interface")" || \
		die "verify: unable to resolve device of instance '$section' ($interface)"

	[ "$mac_mode" = "keep" ] && {
		printf '%s\n' "$dev"
		return 0
	}

	macaddr="$(uci -q get "$CONFIG.$section.macaddr" 2>/dev/null)"
	valid_mac "$macaddr" || \
		die "verify: instance '$section' has invalid macaddr '$macaddr'"

	cur_mac="$(cat "/sys/class/net/$dev/address" 2>/dev/null)"
	[ "$(lower "$cur_mac")" = "$(lower "$macaddr")" ] || \
		die "verify: MAC mismatch on '$dev': expected $macaddr, actual ${cur_mac:-unknown}"

	printf '%s\n' "$dev"
}

case "$1" in
	gen)
		cmd_gen
		;;
	prepare)
		shift
		cmd_prepare "$@"
		;;
	verify)
		shift
		cmd_verify "$@"
		;;
	*)
		usage
		;;
esac
