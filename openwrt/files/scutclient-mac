#!/bin/sh
# scutclient-mac - per-instance MAC helper for scutclient.
#
# Commands:
#   scutclient-mac apply <instance>  Apply the instance MAC (per mac_mode) to
#                                    the bound network device. On success the
#                                    effective MAC is printed on stdout.
#   scutclient-mac gen               Print a random locally administered,
#                                    unicast MAC address.
#
# Security: only UCI section names of /etc/config/scutclient are accepted as
# instance identifiers; devices are always resolved from UCI/ubus, never from
# caller supplied paths or commands.

CONFIG="scutclient"
WAIT_SECONDS=20

die() {
	logger -t scutclient-mac "$1"
	echo "$1" >&2
	exit 1
}

usage() {
	echo "Usage: scutclient-mac apply <instance>" >&2
	echo "       scutclient-mac gen" >&2
	exit 1
}

cmd_gen() {
	local raw b1 b2 b3 b4 b5 b6

	raw="$(od -An -N6 -tu1 /dev/urandom | tr -s ' \n' '  ')"
	set -- $raw
	[ $# -ge 6 ] || die "gen: unable to read random bytes"

	b1="$1"; b2="$2"; b3="$3"; b4="$4"; b5="$5"; b6="$6"

	# Locally administered (bit1=1) and unicast (bit0=0).
	b1=$(( (b1 & 0xFC) | 0x02 ))

	printf '%02X:%02X:%02X:%02X:%02X:%02X\n' \
		"$b1" "$b2" "$b3" "$b4" "$b5" "$b6"
}

instance_type() {
	uci -q show "$CONFIG.$1" 2>/dev/null | head -n 1 | cut -d= -f2
}

lower() {
	printf '%s' "$1" | tr 'A-F' 'a-f'
}

# Resolve the logical interface of an instance to a real netdev.
resolve_device() {
	local configured="$1"
	local device=""

	[ -e "/sys/class/net/$configured" ] && {
		printf '%s\n' "$configured"
		return 0
	}

	device="$(ubus call network.interface."$configured" status 2>/dev/null | \
		jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ -n "$device" ] || device="$(ubus call network.interface."$configured" status 2>/dev/null | \
		jsonfilter -e '@.device' 2>/dev/null)"
	[ -n "$device" ] || return 1

	[ -e "/sys/class/net/$device" ] || return 1

	printf '%s\n' "$device"
}

# Find the wireless STA section in /etc/config/wireless whose network list
# contains $1. Prints the section name.
find_wifi_section() {
	local net="$1"
	local sec mode list item

	for sec in $(uci -q show wireless 2>/dev/null | \
			grep '\.network=' | cut -d. -f2 | cut -d= -f1); do
		[ "$(uci -q get "wireless.$sec.mode" 2>/dev/null)" = "sta" ] || continue
		list="$(uci -q get "wireless.$sec.network" 2>/dev/null)"
		for item in $list; do
			[ "$item" = "$net" ] && {
				printf '%s\n' "$sec"
				return 0
			}
		done
	done
	return 1
}

# Wired device: persist the MAC through a network device section.
apply_wired_mac() {
	local dev="$1" mac="$2"
	local sec devname

	for sec in $(uci -q show network 2>/dev/null | \
			grep '=device$' | cut -d. -f2 | cut -d= -f1); do
		devname="$(uci -q get "network.$sec.name" 2>/dev/null)"
		[ "$devname" = "$dev" ] || continue
		uci -q set "network.$sec.macaddr=$mac"
		uci -q commit network
		return 0
	done

	sec="$(uci add network device)" || return 1
	uci -q set "network.$sec.name=$dev"
	uci -q set "network.$sec.macaddr=$mac"
	uci -q commit network
}

# Wireless STA: persist the MAC on the matching wifi-iface.
apply_wireless_mac() {
	local net="$1" mac="$2"
	local sec

	sec="$(find_wifi_section "$net")" || return 1
	uci -q set "wireless.$sec.macaddr=$mac"
	uci -q commit wireless
}

wait_for_mac() {
	local dev="$1" mac="$2"
	local i=0 cur=""

	while [ "$i" -lt "$WAIT_SECONDS" ]; do
		cur="$(cat "/sys/class/net/$dev/address" 2>/dev/null)"
		[ -n "$cur" ] && [ "$(lower "$cur")" = "$(lower "$mac")" ] && return 0
		i=$((i + 1))
		sleep 1
	done
	return 1
}

cmd_apply() {
	local section="$1"
	local mac_mode macaddr interface dev cur_mac

	[ -n "$section" ] || usage
	[ "$(instance_type "$section")" = "scutclient" ] || \
		die "apply: no such scutclient instance '$section'"

	mac_mode="$(uci -q get "$CONFIG.$section.mac_mode" 2>/dev/null)"
	mac_mode="${mac_mode:-keep}"
	[ "$mac_mode" = "keep" ] && return 0

	macaddr="$(uci -q get "$CONFIG.$section.macaddr" 2>/dev/null)"

	if [ "$mac_mode" = "random" ]; then
		if [ -z "$macaddr" ]; then
			macaddr="$(cmd_gen)"
			uci -q set "$CONFIG.$section.macaddr=$macaddr"
			uci -q commit "$CONFIG"
			logger -t scutclient-mac \
				"instance '$section': generated random MAC $macaddr"
		fi
	else
		[ "$mac_mode" = "custom" ] || die "apply: unknown mac_mode '$mac_mode'"
		[ -n "$macaddr" ] || \
			die "apply: instance '$section' uses custom MAC but macaddr is empty"
	fi

	printf '%s' "$macaddr" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || \
		die "apply: instance '$section' has invalid macaddr '$macaddr'"

	interface="$(uci -q get "$CONFIG.$section.interface" 2>/dev/null)"
	interface="${interface:-wan}"

	dev="$(resolve_device "$interface")" || \
		die "apply: unable to resolve device of instance '$section' ($interface)"

	cur_mac="$(cat "/sys/class/net/$dev/address" 2>/dev/null)"
	if [ "$(lower "$cur_mac")" = "$(lower "$macaddr")" ]; then
		printf '%s\n' "$macaddr"
		return 0
	fi

	if [ -e "/sys/class/net/$dev/phy80211" ] || \
	   find_wifi_section "$interface" >/dev/null 2>&1; then
		if apply_wireless_mac "$interface" "$macaddr"; then
			wifi reload
		else
			logger -t scutclient-mac \
				"instance '$section': no wireless STA section for '$interface', applying MAC at runtime only"
			ip link set dev "$dev" address "$macaddr" 2>/dev/null || \
				ifconfig "$dev" hw ether "$macaddr" 2>/dev/null || \
				die "apply: unable to set MAC on '$dev'"
			wait_for_mac "$dev" "$macaddr" || \
				die "apply: MAC on '$dev' did not become $macaddr"
			printf '%s\n' "$macaddr"
			return 0
		fi
	else
		apply_wired_mac "$dev" "$macaddr" || \
			die "apply: unable to persist MAC for '$dev'"
		/etc/init.d/network reload
	fi

	wait_for_mac "$dev" "$macaddr" || \
		die "apply: MAC on '$dev' did not become $macaddr within ${WAIT_SECONDS}s"

	logger -t scutclient-mac \
		"instance '$section': applied MAC $macaddr on '$dev'"
	printf '%s\n' "$macaddr"
}

case "$1" in
	apply)
		shift
		cmd_apply "$@"
		;;
	gen)
		cmd_gen
		;;
	*)
		usage
		;;
esac
