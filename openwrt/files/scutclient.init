#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1

PROG="/usr/bin/scutclient"
CONFIG="scutclient"
MAC_HELPER="/usr/lib/scutclient/scutclient-mac"
APPLY_LOCK="/var/run/scutclient-network-apply.lock"

EXTRA_COMMANDS="start_instance stop_instance restart_instance logoff_instance logoff"
EXTRA_HELP="
	logoff		Send EAPOL logoff for every instance
	start_instance <id>	Start one scutclient instance
	stop_instance <id>	Stop one scutclient instance
	restart_instance <id>	Restart one scutclient instance
	logoff_instance <id>	Send EAPOL logoff for one instance
"

. /lib/functions.sh
. /lib/functions/network.sh

scutclient_resolve_device() {
	local configured="$1"
	local device=""

	[ -n "$configured" ] || return 1

	# 允许高级用户直接填写真实 Linux netdev。
	if [ -e "/sys/class/net/$configured" ]; then
		printf '%s\n' "$configured"
		return 0
	fi

	# 推荐情况：UCI 中保存 logical interface，例如 wan。
	network_get_device device "$configured" >/dev/null 2>&1

	if [ -z "$device" ] && command -v network_get_physdev >/dev/null 2>&1; then
		network_get_physdev device "$configured" >/dev/null 2>&1
	fi

	[ -n "$device" ] || return 1

	printf '%s\n' "$device"
	return 0
}

# 旧版配置（全局 config scutclient 'account' + config drcom 'settings'）
# 迁移为单实例 config scutclient 'default'。config_version 防止重复迁移。
# 只有迁移代码允许把旧单实例的 interface（如 wan）显式写入新实例。
# v2 → v3：为既有实例补 auth_method=dot1x（向后兼容）。
scutclient_migrate() {
	local cv=""
	local account_type=""

	cv="$(uci -q get "$CONFIG.main.config_version" 2>/dev/null)"

	# 未知/更新版本：不动配置
	if [ "$cv" != "" ] && [ "$cv" != "2" ] && [ "$cv" != "3" ]; then
		return 0
	fi

	# Step 1: 旧版（无 config_version + 旧布局）→ v2
	if [ -z "$cv" ]; then
		account_type="$(uci -q show "$CONFIG" 2>/dev/null | \
			grep -m1 "=scutclient$" | cut -d. -f2 | cut -d= -f1)"

		if [ -n "$account_type" ]; then
			local username password interface
			local dns hostname server_auth_ip version hash
			local nettime onlinehook offlinehook debug enable

			username="$(uci -q get "$CONFIG.$account_type.username" 2>/dev/null)"
			password="$(uci -q get "$CONFIG.$account_type.password" 2>/dev/null)"
			interface="$(uci -q get "$CONFIG.$account_type.interface" 2>/dev/null)"

			dns="$(uci -q get "$CONFIG.settings.dns" 2>/dev/null)"
			hostname="$(uci -q get "$CONFIG.settings.hostname" 2>/dev/null)"
			server_auth_ip="$(uci -q get "$CONFIG.settings.server_auth_ip" 2>/dev/null)"
			version="$(uci -q get "$CONFIG.settings.version" 2>/dev/null)"
			hash="$(uci -q get "$CONFIG.settings.hash" 2>/dev/null)"
			nettime="$(uci -q get "$CONFIG.settings.nettime" 2>/dev/null)"
			onlinehook="$(uci -q get "$CONFIG.settings.onlinehook" 2>/dev/null)"
			offlinehook="$(uci -q get "$CONFIG.settings.offlinehook" 2>/dev/null)"

			debug="$(uci -q get "$CONFIG.main.debug" 2>/dev/null)"
			enable="$(uci -q get "$CONFIG.main.enable" 2>/dev/null)"

			uci -q set "$CONFIG.default=scutclient"
			uci -q set "$CONFIG.default.enabled=1"
			uci -q set "$CONFIG.default.name=WAN"
			[ -n "$username" ] && uci -q set "$CONFIG.default.username=$username"
			[ -n "$password" ] && uci -q set "$CONFIG.default.password=$password"
			[ -n "$interface" ] && uci -q set "$CONFIG.default.interface=$interface"
			[ -n "$server_auth_ip" ] && uci -q set "$CONFIG.default.server_auth_ip=$server_auth_ip"
			[ -n "$dns" ] && uci -q set "$CONFIG.default.dns=$dns"
			[ -n "$hostname" ] && uci -q set "$CONFIG.default.hostname=$hostname"
			[ -n "$version" ] && uci -q set "$CONFIG.default.version=$version"
			[ -n "$hash" ] && uci -q set "$CONFIG.default.hash=$hash"
			[ -n "$nettime" ] && uci -q set "$CONFIG.default.nettime=$nettime"
			[ -n "$onlinehook" ] && uci -q set "$CONFIG.default.onlinehook=$onlinehook"
			[ -n "$offlinehook" ] && uci -q set "$CONFIG.default.offlinehook=$offlinehook"
			[ "$debug" = "1" ] && uci -q set "$CONFIG.default.log_level=debug"

			uci -q delete "$CONFIG.settings" 2>/dev/null
			uci -q delete "$CONFIG.$account_type" 2>/dev/null
			uci -q set "$CONFIG.main.enable=${enable:-0}"

			logger -t scutclient "Migrated legacy configuration to instance 'default'"
		fi

		uci -q set "$CONFIG.main.config_version=2"
		uci -q commit "$CONFIG"
		cv="2"
	fi

	# Step 2: v2 → v3：为既有实例补 auth_method=dot1x
	if [ "$cv" != "3" ]; then
		local sec
		for sec in $(uci -q show "$CONFIG" 2>/dev/null | \
				grep "=scutclient$" | cut -d. -f2 | cut -d= -f1); do
			[ -n "$(uci -q get "$CONFIG.$sec.auth_method" 2>/dev/null)" ] || \
				uci -q set "$CONFIG.$sec.auth_method=dot1x"
		done
		uci -q set "$CONFIG.main.config_version=3"
		uci -q commit "$CONFIG"
	fi
}

scutclient_instance_type() {
	uci -q show "$CONFIG.$1" 2>/dev/null | head -n 1 | cut -d= -f2
}

# ---- 一次启动流程内的共享状态 ----
# WAN 独占：logical interface 与解析后的真实 netdev 都不能重复，
# "netdev:section" 空格分隔。netdev 检查必须在网络 reload 之后进行。
USED_NETWORKS=""
USED_DEVICES=""
WAIT_INTERFACES=""
APPLY_NETWORK=0
APPLY_WIRELESS=0

scutclient_collect_usage() {
	local section="$1"
	local enabled interface device=""

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get interface "$section" interface ""
	[ -n "$interface" ] || return 0

	USED_NETWORKS="$USED_NETWORKS $interface:$section"

	device="$(scutclient_resolve_device "$interface")"
	[ -n "$device" ] && USED_DEVICES="$USED_DEVICES $device:$section"

	return 0
}

scutclient_check_exclusive() {
	local interface="$1"
	local device="$2"
	local section="$3"
	local entry owner

	for entry in $USED_NETWORKS; do
		[ "${entry%%:*}" = "$interface" ] || continue
		owner="${entry#*:}"
		[ "$owner" = "$section" ] || {
			logger -t scutclient \
				"Skip $section: logical interface '$interface' already used by '$owner'"
			return 1
		}
	done

	[ -n "$device" ] || return 0

	for entry in $USED_DEVICES; do
		[ "${entry%%:*}" = "$device" ] || continue
		owner="${entry#*:}"
		[ "$owner" = "$section" ] || {
			logger -t scutclient \
				"Skip $section: device '$device' already used by '$owner'"
			return 1
		}
	done

	return 0
}

# Phase A：校验实例字段并为 random/custom 实例准备 MAC。
# 只写 UCI，不做任何网络 reload。
scutclient_prepare_phase() {
	local section="$1"
	local enabled username password interface mac_mode
	local result=""

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get username "$section" username ""
	config_get password "$section" password ""
	config_get interface "$section" interface ""
	config_get mac_mode "$section" mac_mode "keep"
	config_get auth_method "$section" auth_method "dot1x"
	config_get portal_location "$section" portal_location ""

	[ -n "$username" ] || {
		logger -t scutclient "Skip $section: username is empty"
		return 1
	}

	[ -n "$password" ] || {
		logger -t scutclient "Skip $section: password is empty"
		return 1
	}

	# 不再隐式 fallback 到 wan；配置不完整的实例直接跳过。
	[ -n "$interface" ] || {
		logger -t scutclient "Skip $section: interface is empty"
		return 1
	}

	if [ "$auth_method" = "portal" ]; then
		case "$portal_location" in
			http://*|https://*) ;;
			*)
				logger -t scutclient \
					"Skip $section: portal Location is empty or invalid"
				return 1
				;;
		esac
	fi

	WAIT_INTERFACES="$WAIT_INTERFACES $interface"

	[ "$mac_mode" != "keep" ] || return 0

	result="$("$MAC_HELPER" prepare "$section")" || {
		logger -t scutclient \
			"Skip $section: MAC preparation failed (mode '$mac_mode')"
		return 1
	}

	case "$result" in
		network)
			APPLY_NETWORK=1
			;;
		wireless)
			APPLY_WIRELESS=1
			;;
	esac

	return 0
}

scutclient_wait_wans() {
	local i=0 ifname all_up

	while [ "$i" -lt 30 ]; do
		all_up=1
		for ifname in $WAIT_INTERFACES; do
			[ -n "$(scutclient_resolve_device "$ifname")" ] || all_up=0
		done
		[ "$all_up" -eq 1 ] && return 0
		i=$((i + 1))
		sleep 1
	done

	logger -t scutclient "Timed out waiting for WANs:$WAIT_INTERFACES"
	return 1
}

# Phase A 收尾：所有实例的 MAC 一次性写入后，网络配置最多 reload 一次。
# 加锁期间 hotplug 不动作，避免 reload/restart 循环。
scutclient_apply_network() {
	[ "$APPLY_NETWORK" -eq 1 ] || [ "$APPLY_WIRELESS" -eq 1 ] || return 0

	touch "$APPLY_LOCK"

	[ "$APPLY_NETWORK" -eq 1 ] && /etc/init.d/network reload
	[ "$APPLY_WIRELESS" -eq 1 ] && wifi reload

	scutclient_wait_wans

	rm -f "$APPLY_LOCK"
	return 0
}

# Phase B：只负责解析当前 netdev、复核独占与 MAC，并创建本实例进程。
# 不生成 MAC、不改 network/wireless、不 reload 网络。
scutclient_start_instance() {
	local section="$1"
	local enabled name username password interface
	local dns hostname server_auth_ip version hash
	local nettime onlinehook offlinehook
	local heartbeat_interval heartbeat_timeout eap_timeout eap_retries
	local mac_mode macaddr expected_mac=""
	local auth_method portal_location
	local log_level log_size log_keep log_system log_file
	local ifname=""

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get name "$section" name "$section"
	config_get username "$section" username ""
	config_get password "$section" password ""
	config_get interface "$section" interface ""

	[ -n "$username" ] || {
		logger -t scutclient "Skip $section: username is empty"
		return 1
	}

	[ -n "$password" ] || {
		logger -t scutclient "Skip $section: password is empty"
		return 1
	}

	[ -n "$interface" ] || {
		logger -t scutclient "Skip $section: interface is empty"
		return 1
	}

	config_get dns "$section" dns "222.201.130.30"
	config_get hostname "$section" hostname "Lenovo-PC"
	config_get server_auth_ip "$section" server_auth_ip "202.38.210.131"
	config_get version "$section" version "4472434f4d0096022a"
	config_get hash "$section" hash "2ec15ad258aee9604b18f2f8114da38db16efd00"
	config_get nettime "$section" nettime ""
	config_get onlinehook "$section" onlinehook ""
	config_get offlinehook "$section" offlinehook ""

	config_get heartbeat_interval "$section" heartbeat_interval "12"
	config_get heartbeat_timeout "$section" heartbeat_timeout "2"
	config_get eap_timeout "$section" eap_timeout "1"
	config_get eap_retries "$section" eap_retries "3"

	config_get log_level "$section" log_level "info"
	config_get log_size "$section" log_size "262144"
	config_get log_keep "$section" log_keep "2"
	config_get_bool log_system "$section" log_system 1
	config_get_bool log_file "$section" log_file 1

	# reload 之后重新解析真实 netdev（无线 STA 的 netdev 可能变化）
	ifname="$(scutclient_resolve_device "$interface")"

	[ -n "$ifname" ] || {
		logger -t scutclient \
			"Skip $section: unable to resolve network interface '$interface'"
		return 1
	}

	scutclient_check_exclusive "$interface" "$ifname" "$section" || return 1

	config_get mac_mode "$section" mac_mode "keep"
	if [ "$mac_mode" != "keep" ]; then
		"$MAC_HELPER" verify "$section" >/dev/null || {
			logger -t scutclient \
				"Skip $section: configured MAC is not applied to '$ifname'"
			return 1
		}
		expected_mac="$(uci -q get "$CONFIG.$section.macaddr" 2>/dev/null)"
	fi

	# portal 实例的 Location 在 Phase A 已校验，这里按实例分发认证方式
	config_get auth_method "$section" auth_method "dot1x"
	config_get portal_location "$section" portal_location ""

	logger -t scutclient \
		"Starting $section on logical interface '$interface' ($ifname)"

	procd_open_instance "$section"

	procd_set_param command "$PROG"

	procd_append_param command \
		--username "$username" \
		--password "$password" \
		--iface "$ifname" \
		--dns "$dns" \
		--hostname "$hostname" \
		--udp-server "$server_auth_ip"

	[ -n "$version" ] && \
		procd_append_param command --cli-version "$version"

	[ -n "$hash" ] && \
		procd_append_param command --hash "$hash"

	[ -n "$nettime" ] && \
		procd_append_param command --net-time "$nettime"

	[ -n "$onlinehook" ] && \
		procd_append_param command --online-hook "$onlinehook"

	[ -n "$offlinehook" ] && \
		procd_append_param command --offline-hook "$offlinehook"

	procd_append_param command \
		--heartbeat-interval "$heartbeat_interval" \
		--heartbeat-timeout "$heartbeat_timeout" \
		--eap-timeout "$eap_timeout" \
		--eap-retries "$eap_retries"

	[ -n "$expected_mac" ] && \
		procd_append_param command --expected-mac "$expected_mac"

	procd_append_param command \
		--instance "$section" \
		--log-level "$log_level" \
		--log-max-size "$log_size" \
		--log-keep "$log_keep"

	# 按实例分发认证方式；portal 的 Location 已在前面校验过
	if [ "$auth_method" = "portal" ]; then
		local portal_suffix portal_connect_timeout portal_timeout
		local portal_check_interval portal_tls_verify
		local portal_http_port portal_https_port

		config_get portal_suffix "$section" portal_suffix ""
		config_get portal_connect_timeout "$section" portal_connect_timeout "5"
		config_get portal_timeout "$section" portal_timeout "10"
		config_get portal_check_interval "$section" portal_check_interval "15"
		config_get_bool portal_tls_verify "$section" portal_tls_verify 1
		config_get portal_http_port "$section" portal_http_port "801"
		config_get portal_https_port "$section" portal_https_port "802"
		config_get portal_login_mode "$section" portal_protocol "auto"
		config_get portal_program_index "$section" portal_program_index ""
		config_get portal_page_index "$section" portal_page_index ""
		config_get portal_js_version "$section" portal_js_version ""
		config_get portal_r3 "$section" portal_r3 ""

		procd_append_param command \
			--auth-method portal \
			--portal-location "$portal_location" \
			--portal-connect-timeout "$portal_connect_timeout" \
			--portal-timeout "$portal_timeout" \
			--portal-check-interval "$portal_check_interval" \
			--portal-tls-verify "$portal_tls_verify" \
			--portal-http-port "$portal_http_port" \
			--portal-https-port "$portal_https_port" \
			--portal-login-mode "$portal_login_mode"

		[ -n "$portal_suffix" ] && \
			procd_append_param command --portal-suffix "$portal_suffix"

		# 页面运行时数据 override：留空不传
		[ -n "$portal_program_index" ] && \
			procd_append_param command --portal-program-index "$portal_program_index"
		[ -n "$portal_page_index" ] && \
			procd_append_param command --portal-page-index "$portal_page_index"
		[ -n "$portal_js_version" ] && \
			procd_append_param command --portal-js-version "$portal_js_version"
		[ -n "$portal_r3" ] && \
			procd_append_param command --portal-r3 "$portal_r3"
	else
		procd_append_param command --auth-method dot1x
	fi

	[ "$log_file" -eq 1 ] && \
		procd_append_param command --log-file "/tmp/scutclient/$section.log"

	procd_set_param netdev "$ifname"

	# system log 由 procd 接管 stdout/stderr
	[ "$log_system" -eq 1 ] && {
		procd_set_param stdout 1
		procd_set_param stderr 1
	}

	procd_close_instance
}

start_service() {
	scutclient_migrate

	config_load "$CONFIG"

	local enable=0
	config_get_bool enable "main" enable 0

	[ "$enable" -eq 1 ] || {
		logger -t scutclient "Service disabled by UCI"
		return 0
	}

	# Phase A：字段校验 + 全部实例 MAC prepare（无 reload）
	USED_NETWORKS=""
	USED_DEVICES=""
	WAIT_INTERFACES=""
	APPLY_NETWORK=0
	APPLY_WIRELESS=0
	config_foreach scutclient_prepare_phase scutclient

	# 网络配置最多 reload 一次，随后等待所有 WAN 恢复
	scutclient_apply_network

	# Phase B：reload 后重新解析，logical + netdev 唯一性在此复核
	USED_NETWORKS=""
	USED_DEVICES=""
	config_foreach scutclient_collect_usage scutclient

	config_foreach scutclient_start_instance scutclient
}

service_triggers() {
	# 接口热插拔由 hotplug 按实例处理（ifup/ifdown），
	# 这里不再注册整服务级别的 interface trigger。
	procd_add_reload_trigger "$CONFIG"
	procd_add_reload_trigger network
}

reload_service() {
	stop
	start
}

scutclient_logoff_instance() {
	local section="$1"
	local interface=""
	local auth_method="dot1x"
	local portal_location=""
	local ifname=""

	config_get interface "$section" interface ""
	config_get auth_method "$section" auth_method "dot1x"
	config_get portal_location "$section" portal_location ""

	[ -n "$interface" ] || {
		logger -t scutclient \
			"Unable to log off $section: interface is empty"
		return 1
	}

	ifname="$(scutclient_resolve_device "$interface")"

	[ -n "$ifname" ] || {
		logger -t scutclient \
			"Unable to log off: cannot resolve '$interface'"
		return 1
	}

	if [ "$auth_method" = "portal" ]; then
		case "$portal_location" in
			http://*|https://*)
				"$PROG" --iface "$ifname" --auth-method portal \
					--portal-location "$portal_location" --logoff
				return 0
				;;
			*)
				logger -t scutclient \
					"Unable to log off $section: portal Location is empty or invalid"
				return 1
				;;
		esac
	fi

	"$PROG" --iface "$ifname" --logoff
}

logoff() {
	config_load "$CONFIG"
	config_foreach scutclient_logoff_instance scutclient
}

scutclient_check_instance() {
	local section="$1"

	[ -n "$section" ] || return 1
	[ "$(scutclient_instance_type "$section")" = "scutclient" ] || {
		logger -t scutclient "No such scutclient instance: '$section'"
		return 1
	}
	return 0
}

start_instance() {
	local section="$1"
	local interface="" mac_mode result=""

	scutclient_check_instance "$section" || return 1

	config_load "$CONFIG"

	# 单实例启动同样走 prepare ->（必要时一次 reload）-> spawn
	config_get interface "$section" interface ""
	[ -n "$interface" ] || {
		logger -t scutclient "Skip $section: interface is empty"
		return 1
	}

	WAIT_INTERFACES="$interface"
	APPLY_NETWORK=0
	APPLY_WIRELESS=0

	config_get mac_mode "$section" mac_mode "keep"
	if [ "$mac_mode" != "keep" ]; then
		result="$("$MAC_HELPER" prepare "$section")" || {
			logger -t scutclient \
				"Skip $section: MAC preparation failed (mode '$mac_mode')"
			return 1
		}
		case "$result" in
			network) APPLY_NETWORK=1 ;;
			wireless) APPLY_WIRELESS=1 ;;
		esac
	fi

	scutclient_apply_network

	USED_NETWORKS=""
	USED_DEVICES=""
	config_foreach scutclient_collect_usage scutclient

	scutclient_start_instance "$section"
}

stop_instance() {
	local section="$1"

	scutclient_check_instance "$section" || return 1

	procd_kill "$CONFIG" "$section"
}

restart_instance() {
	local section="$1"

	scutclient_check_instance "$section" || return 1

	stop_instance "$section"
	# 等待旧进程完成 EAPOL logoff，避免同 MAC 会话冲突
	sleep 1
	start_instance "$section"
}

logoff_instance() {
	local section="$1"

	scutclient_check_instance "$section" || return 1

	config_load "$CONFIG"
	scutclient_logoff_instance "$section"
}
