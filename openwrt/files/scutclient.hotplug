#!/bin/sh

[ "$ACTION" = "ifup" ] || exit 0
[ -n "$INTERFACE" ] || exit 0

. /lib/functions.sh

SC_ENABLED=0
SC_MATCHED=0

scutclient_hotplug_load_option() {
	local section="$1"
	config_get_bool SC_ENABLED "$section" enable 0
}

scutclient_hotplug_match_interface() {
	local section="$1"
	local interface="wan"

	config_get interface "$section" interface "wan"

	[ "$interface" = "$INTERFACE" ] && SC_MATCHED=1
}

config_load scutclient
config_foreach scutclient_hotplug_load_option option

[ "$SC_ENABLED" -eq 1 ] || exit 0

config_foreach scutclient_hotplug_match_interface scutclient

[ "$SC_MATCHED" -eq 1 ] || exit 0

# procd interface trigger 正常时通常已经处理。
# hotplug 只作为 fallback，不对已经运行的服务重复 restart。
if /etc/init.d/scutclient running >/dev/null 2>&1; then
	exit 0
fi

logger -t scutclient \
	"Interface '$INTERFACE' is up; starting scutclient"

/etc/init.d/scutclient start