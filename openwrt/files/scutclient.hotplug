#!/bin/sh

[ "$ACTION" = "ifup" ] || exit 0
[ -n "$INTERFACE" ] || exit 0

. /lib/functions.sh

SC_MAIN_ENABLE=0

scutclient_hotplug_load_option() {
	local section="$1"
	config_get_bool SC_MAIN_ENABLE "$section" enable 0
}

scutclient_hotplug_restart_instance() {
	local section="$1"
	local enabled interface

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get interface "$section" interface "wan"

	# 只重启绑定该 WAN 的实例，不影响其他已认证实例
	[ "$interface" = "$INTERFACE" ] || return 0

	logger -t scutclient \
		"Interface '$INTERFACE' is up; restarting instance '$section'"

	/etc/init.d/scutclient restart_instance "$section"
}

config_load scutclient
config_foreach scutclient_hotplug_load_option option

[ "$SC_MAIN_ENABLE" -eq 1 ] || exit 0

config_foreach scutclient_hotplug_restart_instance scutclient

exit 0
