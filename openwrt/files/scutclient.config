# scutclient UCI configuration
#
# config option 'main'     - service level settings.
# config scutclient '<id>' - one authentication instance per section.
#                            The section name is the instance id shared by
#                            procd, the LuCI app and the per-instance log file.
#
# One instance binds exactly one WAN (logical interface), and one WAN can
# only be bound by one instance.

config option 'main'
	option enable '0'
	option config_version '2'

# Example instance (uncomment and adjust, or manage instances from LuCI):
#
#config scutclient 'wan_main'
#	option enabled '0'
#	option name 'Wired WAN'
#
#	option username ''
#	option password ''
#	option interface 'wan'
#
#	option mac_mode 'keep'
#	option macaddr ''
#
#	option server_auth_ip '202.38.210.131'
#	option dns '222.201.130.30'
#	option hostname 'Lenovo-PC'
#	option version '4472434f4d0096022a'
#	option hash '2ec15ad258aee9604b18f2f8114da38db16efd00'
#
#	option nettime ''
#	option onlinehook ''
#	option offlinehook ''
#
#	option heartbeat_interval '12'
#	option heartbeat_timeout '2'
#	option eap_timeout '1'
#	option eap_retries '3'
#
#	option log_level 'info'
#	option log_size '262144'
#	option log_keep '2'
#	option log_system '1'
#	option log_file '1'
